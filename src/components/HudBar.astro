---
import { portfolio } from '../data/portfolio';
const nodesTotal  = portfolio.experience.length;
const skillsTotal = portfolio.skills.reduce((sum, g) => sum + g.items.length, 0);
---

<div class="hud">
  <span class="hud__1up">1UP</span>

  <span class="hud__label hud__label--hp">HP</span>
  <div class="hud__bar hud__bar--hp" role="meter" aria-label="HP: full" aria-valuenow="92" aria-valuemin="0" aria-valuemax="100">
    <div class="hud__fill hud__fill--hp"></div>
  </div>

  <span class="hud__label hud__label--xp">XP</span>
  <div class="hud__bar hud__bar--xp" role="meter" aria-label="XP" aria-valuenow="78" aria-valuemin="0" aria-valuemax="100">
    <div class="hud__fill hud__fill--xp"></div>
  </div>

  <span class="hud__stat hud__stat--nodes">
    <span class="hud__stat-label">NODES</span>
    <span class="hud__stat-value" id="hud-nodes" aria-live="polite">0/{nodesTotal}</span>
  </span>
  <span class="hud__stat hud__stat--skills">
    <span class="hud__stat-label">SKILLS</span>
    <span class="hud__stat-value" id="hud-skills" aria-live="polite">0/{skillsTotal}</span>
  </span>
  <span class="hud__level" id="hud-level" aria-live="polite">LV.1</span>

  <span class="hud__coin" aria-hidden="true"></span>
  <span class="hud__coinx">x∞</span>

  <button class="hud__mute" id="mute-toggle" aria-label="Toggle audio (currently muted)" aria-pressed="true">
    🔇
  </button>
</div>

<script define:vars={{ nodesTotal, skillsTotal }}>
  // Pre-hydration seed: avoid flash of "0/N" when sessionStorage already has progress.
  const readLen = (key) => {
    try {
      const raw = sessionStorage.getItem(key);
      if (!raw) return 0;
      const parsed = JSON.parse(raw);
      return Array.isArray(parsed) ? parsed.length : 0;
    } catch { return 0; }
  };
  const n = readLen('gp-visited-nodes');
  const s = readLen('gp-collected-skills');
  const lv = Math.min(99, Math.max(1, Math.floor((n * 3 + s * 0.5) / 5)));
  const set = (id, txt) => { const el = document.getElementById(id); if (el) el.textContent = txt; };
  set('hud-nodes',  `${n}/${nodesTotal}`);
  set('hud-skills', `${s}/${skillsTotal}`);
  set('hud-level',  `LV.${lv}`);
</script>

<style>
  .hud {
    display: flex;
    align-items: center;
    gap: 14px;
    font-family: 'Press Start 2P', monospace;
    font-size: var(--fs-hud);
    margin-bottom: 22px;
    flex-wrap: wrap;
  }

  .hud__1up   { color: var(--c-green); }
  .hud__coinx { color: var(--c-ink); font-size: 8px; }

  .hud__stat        { display: inline-flex; align-items: center; gap: 4px; }
  .hud__stat-label  { font-size: 8px; }
  .hud__stat--nodes  .hud__stat-label { color: var(--c-green); }
  .hud__stat--skills .hud__stat-label { color: var(--c-cyan); }
  .hud__stat-value  { font-size: var(--fs-hud); color: var(--c-ink); }

  .hud__level { color: var(--c-yellow); font-size: var(--fs-hud); }

  @media (prefers-reduced-motion: no-preference) {
    .hud__level--flash { animation: hud-level-flash 0.45s steps(1, end) 3; }
  }
  @keyframes hud-level-flash {
    0%, 49%   { color: var(--c-yellow); }
    50%, 100% { color: #fff; }
  }

  .hud__label { font-size: 8px; }
  .hud__label--hp { color: var(--c-red); }
  .hud__label--xp { color: var(--c-cyan); }

  /* HP bar */
  .hud__bar {
    height: 12px;
    background: #231a44;
    box-shadow: 0 0 0 2px var(--c-faint);
    flex-shrink: 0;
  }
  .hud__bar--hp { width: 120px; }
  .hud__bar--xp { flex: 1; min-width: 60px; }

  .hud__fill {
    height: 100%;
  }

  .hud__fill--hp {
    width: 92%;
    background: repeating-linear-gradient(90deg, var(--c-red) 0 8px, #d83b54 8px 12px);
    background-size: 12px 100%;
  }

  .hud__fill--xp {
    width: 78%;
    background: repeating-linear-gradient(90deg, var(--c-cyan) 0 8px, #2bb8b2 8px 12px);
    background-size: 12px 100%;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hud__fill--hp { animation: barber 0.6s linear infinite; }
    .hud__fill--xp { animation: barber 0.6s linear infinite; }
  }

  .hud__coin {
    display: inline-block;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--c-yellow);
    box-shadow: inset -2px -2px 0 var(--c-orange);
  }

  .hud__mute {
    margin-left: auto;
    background: none;
    border: none;
    cursor: pointer;
    font-size: 14px;
    padding: 2px 4px;
    color: var(--c-ink);
    line-height: 1;
  }

  @media (max-width: 680px) {
    .hud__coin,
    .hud__coinx { display: none; }
    .hud__stat-label { display: none; }
  }
</style>

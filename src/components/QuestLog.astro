---
import PixelPanel from './PixelPanel.astro';
import { portfolio } from '../data/portfolio';
---

<PixelPanel accent="blue" label="QUEST LOG · WHO AM I" class="quest-log">
  <div class="quest-log__inner">
    <span class="quest-log__glyph" aria-hidden="true">‹›</span>
    <div class="quest-log__text">
      <p class="quest-log__bio">{portfolio.about}</p>
      <p class="quest-log__lately">
        ► {portfolio.aboutNow}<span class="quest-log__cursor blink" aria-hidden="true">▼</span>
      </p>
    </div>
  </div>
</PixelPanel>

<style>
  .quest-log__inner {
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }

  .quest-log__glyph {
    font-family: 'Press Start 2P', monospace;
    font-size: 22px;
    color: var(--c-blue);
    flex-shrink: 0;
    line-height: 1;
    margin-top: 2px;
  }

  .quest-log__text {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .quest-log__bio {
    font-family: 'Silkscreen', monospace;
    font-size: var(--fs-bio);
    color: var(--c-ink);
    line-height: 1.55;
  }

  .quest-log__lately {
    font-family: 'Silkscreen', monospace;
    font-size: var(--fs-lately);
    color: var(--c-yellow);
    line-height: 1.5;
  }

  .quest-log__cursor {
    margin-left: 4px;
    color: var(--c-yellow);
  }
</style>

---
import PixelPanel from './PixelPanel.astro';
import { portfolio } from '../data/portfolio';

const RARITY = [
  { tag: 'LEGENDARY', color: 'var(--c-yellow)' },
  { tag: 'EPIC',      color: 'var(--c-purple)' },
  { tag: 'EPIC',      color: 'var(--c-purple)' },
  { tag: 'RARE',      color: 'var(--c-cyan)'   },
  { tag: 'COMMON',    color: 'var(--c-green)'  },
];
---

<PixelPanel accent="purple" label="SKILL TREE · INVENTORY" class="skill-tree" reveal="scale-pop">
  <div class="skill-tree__grid">
    {portfolio.skills.map((group, i) => {
      const r = RARITY[i];
      return (
        <div class="skill-card" style={`box-shadow:0 0 0 2px ${r.color},inset -2px -2px 0 rgba(0,0,0,.3)`}>
          <div class="skill-card__header">
            <span class="skill-card__group" style={`color:${r.color}`}>◆ {group.group}</span>
            <span class="skill-card__tag" style={`color:${r.color}`}>{r.tag}</span>
          </div>
          <div class="skill-card__items">
            {group.items.map(item => (
              <span
                class="skill-chip"
                data-skill={`${group.group}:${item}`}
                role="button"
                tabindex="0"
                aria-pressed="false"
                aria-label={`Collect ${item}`}
              >{item}</span>
            ))}
          </div>
        </div>
      );
    })}
  </div>
  <p class="skill-tree__note">{portfolio.skillTreeNote}</p>
</PixelPanel>

<style>
  .skill-tree__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }

  .skill-card {
    background: var(--c-panelHi);
    padding: 10px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .skill-card {
      transition: transform 0.1s;
    }

    .skill-card:hover {
      transform: translateY(-3px);
    }
  }

  .skill-card__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
    gap: 4px;
  }

  .skill-card__group {
    font-family: 'Silkscreen', monospace;
    font-size: 14px;
  }

  .skill-card__tag {
    font-family: 'Press Start 2P', monospace;
    font-size: 6px;
    flex-shrink: 0;
  }

  .skill-card__items {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .skill-chip {
    font-family: 'Silkscreen', monospace;
    font-size: var(--fs-chip);
    color: var(--c-ink);
    background: #0f0a26;
    padding: 2px 6px;
    box-shadow: 0 0 0 1px var(--c-faint);
    cursor: pointer;
    user-select: none;
  }

  .skill-chip:focus-visible {
    outline: 2px solid var(--c-yellow);
    outline-offset: 1px;
  }

  .skill-chip--collected {
    box-shadow: 0 0 0 1px var(--c-yellow), 0 0 6px color-mix(in srgb, var(--c-yellow) 60%, transparent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .skill-chip--pop {
      animation: skill-chip-pop 0.16s steps(2, end) 1;
    }
  }

  @keyframes skill-chip-pop {
    0%   { transform: scale(1);   }
    50%  { transform: scale(1.3); }
    100% { transform: scale(1);   }
  }

  @media (max-width: 680px) {
    .skill-tree__grid {
      grid-template-columns: 1fr;
    }
  }

  .skill-tree__note {
    font-family: 'Silkscreen', monospace;
    font-size: 12px;
    color: var(--c-dim);
    margin-top: 14px;
    line-height: 1.5;
  }
</style>

---
import PixelPanel from './PixelPanel.astro';
import { portfolio, type Experience } from '../data/portfolio';
---

<PixelPanel accent="yellow" label="WORLD MAP · CAREER STAGES" class="world-map">
  <div class="wm-timeline" id="world-map-timeline">
    {portfolio.experience.map((job: Experience, i: number) => {
      const isNow = job.status === 'NOW PLAYING';
      return (
        <div class="wm-row">
          <div class="wm-rail">
            <button
              class:list={['wm-node', isNow && 'wm-node--current']}
              aria-label={`Level ${job.lvl} — ${job.company}, ${job.role}${isNow ? ', currently playing' : ''}`}
              data-job-index={i}
            >
              {job.lvl}
            </button>
            {i < portfolio.experience.length - 1 && (
              <div class="wm-connector" aria-hidden="true"></div>
            )}
          </div>

          <div class="wm-card">
            <div class="wm-card__header">
              <span class="wm-card__company">{job.company}</span>
              <span class:list={['wm-card__status', isNow ? 'wm-card__status--now' : 'wm-card__status--cleared']}>
                {isNow ? '▶' : '✓'} {job.status}
              </span>
            </div>
            <p class="wm-card__lvl">[LVL {job.lvl}]</p>
            <p class="wm-card__role">{job.role}</p>
            <p class="wm-card__tech">{job.tech}</p>
            {job.bullets.length > 0 && (
              <ul class="wm-card__bullets">
                {job.bullets.map((b: string) => (
                  <li class="wm-card__bullet">{b}</li>
                ))}
              </ul>
            )}
            {job.bullets.length === 0 && (
              <p class="wm-card__note">{job.note}</p>
            )}
          </div>
        </div>
      );
    })}
  </div>
</PixelPanel>

<style>
  .wm-timeline {
    display: flex;
    flex-direction: column;
  }

  .wm-row {
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }

  .wm-rail {
    width: 54px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .wm-node {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Press Start 2P', monospace;
    font-size: 10px;
    cursor: pointer;
    background: var(--c-panelHi);
    color: var(--c-dim);
    border: none;
    box-shadow: 0 0 0 3px var(--c-bg0), 0 0 0 5px var(--c-faint);
    flex-shrink: 0;
  }

  .wm-node--current {
    background: var(--c-green);
    color: var(--c-bg0);
    box-shadow: 0 0 0 3px var(--c-bg0), 0 0 0 5px var(--c-green);
  }

  @media (prefers-reduced-motion: no-preference) {
    .wm-node--current {
      animation: pulseGlow 1.8s ease-in-out infinite;
    }
  }

  .wm-connector {
    width: 4px;
    flex: 1;
    min-height: 24px;
    background: repeating-linear-gradient(
      to bottom,
      var(--c-faint) 0 5px,
      transparent 5px 10px
    );
    margin: 4px 0;
  }

  .wm-card {
    flex: 1;
    padding: 6px 0 20px;
  }

  .wm-card__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 8px;
    margin-bottom: 6px;
    flex-wrap: wrap;
  }

  .wm-card__company {
    font-family: 'Press Start 2P', monospace;
    font-size: var(--fs-company);
    color: var(--c-ink);
    line-height: 1.4;
  }

  .wm-card__status {
    font-family: 'Press Start 2P', monospace;
    font-size: 7px;
    flex-shrink: 0;
  }

  .wm-card__status--now     { color: var(--c-green); }
  .wm-card__status--cleared { color: var(--c-yellow); }

  .wm-card__lvl {
    font-family: 'Press Start 2P', monospace;
    font-size: 7px;
    color: var(--c-dim);
    margin-bottom: 4px;
  }

  .wm-card__role {
    font-family: 'Silkscreen', monospace;
    font-size: var(--fs-role);
    color: var(--c-cyan);
    margin-bottom: 4px;
  }

  .wm-card__tech {
    font-family: 'Silkscreen', monospace;
    font-size: var(--fs-tech);
    color: var(--c-dim);
    margin-bottom: 3px;
  }

  .wm-card__note {
    font-family: 'Silkscreen', monospace;
    font-size: var(--fs-tech);
    color: var(--c-faint);
  }

  .wm-card__bullets {
    list-style: none;
    margin-top: 8px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .wm-card__bullet {
    font-family: 'Silkscreen', monospace;
    font-size: var(--fs-tech);
    color: var(--c-ink);
    line-height: 1.5;
    padding-left: 12px;
    position: relative;
  }

  .wm-card__bullet::before {
    content: '▸';
    position: absolute;
    left: 0;
    color: var(--c-yellow);
  }
</style>

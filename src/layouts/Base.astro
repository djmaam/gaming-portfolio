---
export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Marcos Arrieta — Software Engineer & AI Orchestrator",
  description = "Tech enthusiast — a restless mind that always wants to solve problems. Focused on building solutions that help people and make their lives easier.",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og-image.png', Astro.site);

// 54 deterministic stars (SSR — no Math.random drift between hydrations)
const stars = Array.from({ length: 54 }, (_, i) => {
  const seed = (i * 2654435761) >>> 0;
  const x = ((seed & 0xffff) / 0xffff * 100).toFixed(2);
  const y = (((seed >> 16) & 0xffff) / 0xffff * 100).toFixed(2);
  const delay = ((i * 0.37) % 3).toFixed(2);
  const big = i % 5 === 0;
  const color = i % 7 === 0 ? '#46e6e0' : i % 5 === 0 ? '#ff7ad9' : '#ffffff';
  return { x, y, delay, big, color };
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- OG / Twitter -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <title>{title}</title>

    <!-- Fonts: self-hosted (public/fonts/) — swap to Google Fonts if needed -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Silkscreen:wght@400;700&display=swap"
      rel="stylesheet"
    />

    <!-- Favicon placeholder — replace with pixel coin/hero sprite -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- GP-20 reveal arming: set gp-armed synchronously so panel-reveal CSS
         only hides panels when JS is parseable AND motion is allowed.
         Falls back to gp-reveal-fallback after 1.5s if hydration stalls,
         force-revealing every panel so client:idle delays don't leave
         above-the-fold content blank. -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        d.classList.add('gp-armed');
        setTimeout(function () { d.classList.add('gp-reveal-fallback'); }, 1500);
      })();
    </script>
  </head>

  <body>
    <!-- Global background -->
    <div class="bg-gradient" aria-hidden="true"></div>

    <!-- Starfield (z-index 0, pointer-events none) -->
    <div class="starfield" aria-hidden="true">
      {stars.map((s, i) => (
        <div
          class:list={['star', s.big && 'star--big']}
          style={`left:${s.x}%;top:${s.y}%;background:${s.color};animation-delay:${s.delay}s;animation-duration:${2 + (i % 4)}s`}
        />
      ))}
    </div>

    <!-- Page content -->
    <div class="page-frame">
      <slot />
    </div>

    <!-- Scanlines (z-index 9, always on top) -->
    <div class="scanlines" aria-hidden="true"></div>
    <!-- Vignette (z-index 9) -->
    <div class="vignette" aria-hidden="true"></div>
  </body>
</html>

<style is:global>
  @import '../styles/tokens.css';

  body {
    position: relative;
    min-height: 100vh;
    overflow-x: hidden;
  }

  .bg-gradient {
    position: fixed;
    inset: 0;
    z-index: -1;
    background: radial-gradient(120% 80% at 50% -10%, var(--c-bg1) 0%, var(--c-bg0) 60%);
  }

  .starfield {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .star {
    position: absolute;
    width: 2px;
    height: 2px;
    opacity: 0.5;
  }

  .star--big {
    width: 4px;
    height: 4px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .star {
      animation: twinkle 3s steps(2) infinite;
    }
  }

  .page-frame {
    position: relative;
    z-index: 1;
    width: min(var(--frame-width), 100%);
    margin: 0 auto;
    padding: var(--frame-pad);
  }

  .scanlines {
    position: fixed;
    inset: 0;
    z-index: 9;
    pointer-events: none;
    background: repeating-linear-gradient(
      rgba(0, 0, 0, 0) 0 2px,
      rgba(0, 0, 0, 0.18) 3px 4px
    );
  }

  .vignette {
    position: fixed;
    inset: 0;
    z-index: 9;
    pointer-events: none;
    box-shadow: inset 0 0 120px 24px rgba(0, 0, 0, 0.7);
  }

  /* Responsive: narrow screens */
  @media (max-width: 680px) {
    .page-frame {
      padding: 16px;
    }
  }
</style>
